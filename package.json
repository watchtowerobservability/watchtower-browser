{
  "name": "@watchtowerobservability/browser",
  "version": "0.1.0",
  "repository": { "type": "git", "url": "git+https://github.com/watchtowerobservability/watchtower-browser.git" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "description": "Watchtower browser SDK: errors, vitals, sessions and transport",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/adapters/react.js",
    "./next": "./dist/adapters/next.js",
    "./vue": "./dist/adapters/vue.js",
    "./angular": "./dist/adapters/angular.js",
    "./svelte": "./dist/adapters/svelte.js",
    "./vite-plugin": "./dist/plugins/vite.js",
    "./rollup-plugin": "./dist/plugins/rollup.js",
    "./webpack-plugin": "./dist/plugins/webpack.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.200.0",
    "@opentelemetry/instrumentation": "0.200.0",
    "@opentelemetry/instrumentation-fetch": "0.200.0",
    "@opentelemetry/instrumentation-xml-http-request": "0.200.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-trace-web": "2.0.1",
    "fflate": "0.8.2",
    "rrweb": "2.0.0-alpha.18",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.25.10",
    "happy-dom": "21.0.4",
    "vitest": "5.0.5"
  }
}
