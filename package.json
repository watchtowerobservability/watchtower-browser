{
  "name": "@watchtowerobservability/browser",
  "version": "0.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchtowerobservability/watchtower-browser.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Watchtower browser SDK: errors, vitals, sessions and transport",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./consent": {
      "types": "./dist/consent.d.ts",
      "default": "./dist/consent.js"
    },
    "./react": {
      "types": "./dist/adapters/react.d.ts",
      "default": "./dist/adapters/react.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "default": "./dist/adapters/next.js"
    },
    "./vue": {
      "types": "./dist/adapters/vue.d.ts",
      "default": "./dist/adapters/vue.js"
    },
    "./angular": {
      "types": "./dist/adapters/angular.d.ts",
      "default": "./dist/adapters/angular.js"
    },
    "./svelte": {
      "types": "./dist/adapters/svelte.d.ts",
      "default": "./dist/adapters/svelte.js"
    },
    "./vite-plugin": "./dist/plugins/vite.js",
    "./rollup-plugin": "./dist/plugins/rollup.js",
    "./webpack-plugin": "./dist/plugins/webpack.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "fflate": "0.8.2",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "0.200.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-fetch": "0.200.0",
    "@opentelemetry/instrumentation-xml-http-request": "0.200.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-trace-web": "2.0.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.25.10",
    "happy-dom": "21.0.4",
    "react": "18.3.1",
    "rrweb": "2.0.0-alpha.18",
    "vitest": "5.0.5"
  }
}
